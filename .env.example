# ── NetGuard AI — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to git.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Flask environment: development | production | testing
FLASK_ENV=development

# Database URI (default: local SQLite in instance/)
# DATABASE_URL=postgresql://user:password@localhost:5432/netguard

# Upload size limit (bytes) — default 100 MB
MAX_CONTENT_LENGTH=104857600
